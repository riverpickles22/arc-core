#!/usr/bin/env bash
# Every commit runs this repo's check first (AGENTS.md "When you finish").
# Installed by dev.sh, which points core.hooksPath at .githooks. It checks the
# working tree, so stage what you tested.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
# git exports these to hooks; tests that spawn git in temp repos must not inherit them.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
if ! tools/check.sh; then
  echo >&2
  echo "pre-commit: the check failed — commit refused. Fix it, or ask the author." >&2
  exit 1
fi
