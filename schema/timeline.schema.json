{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arc.dev/schema/timeline.schema.json",
  "title": "arc timeline (canon/timeline.yaml)",
  "type": "object",
  "properties": {
    "eras": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/eraId" },
          "name": { "type": "string" },
          "span": { "$ref": "common.schema.json#/$defs/span" },
          "mood": { "type": "string" },
          "notes": { "type": "string" }
        },
        "required": ["id", "name", "span"],
        "additionalProperties": false
      }
    },
    "anchors": {
      "description": "Named timepoints for precise state keys",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/timepointId" },
          "date": { "$ref": "common.schema.json#/$defs/date" },
          "label": { "type": "string" },
          "approximate": { "type": "boolean" }
        },
        "required": ["id", "date", "label"],
        "additionalProperties": false
      }
    }
  },
  "required": ["eras"],
  "additionalProperties": false
}
